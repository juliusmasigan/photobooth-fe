# Booth behaviour
REACT_APP_COUNTDOWN_TIMER_SECONDS=5
REACT_APP_IDLE_TIMEOUT_SECONDS=300
REACT_APP_BOOTH_MODES=still,collage,gif,boomerang,wigglegram
REACT_APP_COLLAGE_LAYOUT_COUNT=4
REACT_APP_BOOMERANG_BURST_COUNT=10
REACT_APP_EXTRA_SHOTS_FOR_SELECTION=0
REACT_APP_PRINT_COPIES=1

# Camera backend
REACT_APP_CAMERA_WEBSOCKET_URL=ws://localhost:8000/ws
REACT_APP_API_BASE_URL=http://localhost:8000

# Remote control (QR on the capture screen) — see docs/remote-relay.md
# Relay socket on the camera backend; defaults to REACT_APP_CAMERA_WEBSOCKET_URL with /ws -> /ws/remote
REACT_APP_REMOTE_WEBSOCKET_URL=ws://localhost:8000/ws/remote
# This app's address as reachable from a phone on the LAN; defaults to the kiosk's own origin
REACT_APP_REMOTE_BASE_URL=http://192.168.1.x:3000

# Contact details shown in the info overlay
REACT_APP_CONTACT_PHONE=
REACT_APP_CONTACT_EMAIL=
REACT_APP_CONTACT_WEBSITE=
REACT_APP_CONTACT_SOCIALS=
